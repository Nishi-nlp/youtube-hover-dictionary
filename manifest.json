{
  "manifest_version": 3,
  "name": "YouTube Dual Subtitles & Vocab",
  "version": "1.2",
  "description": "英語字幕の難しい単語をハイライトして表示します。",
  "permissions": ["storage", "activeTab", "scripting"],
  "host_permissions": [
    "https://www.youtube.com/*",
    "https://video.google.com/*"
  ],
  "content_scripts": [
    {
      "matches": ["*://www.youtube.com/*"],
      "js": ["dist/content.js"],
      "run_at": "document_idle"
    }
  ],
  "web_accessible_resources": [
    {
      "resources": [
        "assets/wordDict.json",
        "assets/phraseDict.json"
      ],
      "matches": ["*://www.youtube.com/*"]
    }
  ],
  "action": {
    "default_popup": "popup.html"
  }
}